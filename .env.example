# Minnas — developer overrides. Copy to `.env` and fill in.
#
# Settings live in the app (Settings window): UserDefaults for plain
# values, the login Keychain for the one secret (OPENAI_API_KEY). The first
# time the .app runs it copies the app-support .env (below), if there is
# one, into Settings/Keychain once; the file is left in place as a
# fallback. Inspect or change settings from the shell with
#   .build/Minnas.app/Contents/MacOS/minnas --settings
#   ... --settings set <name> <value>     (value "-" reads stdin)
#   ... --settings unset <name>
#
# Precedence, first hit wins:
#   1. an environment variable of the same name, e.g.
#      `TRANSCRIPTS_DIR=/tmp/t swift run minnas ...`
#   2. Settings / Keychain. The Keychain only from inside the .app bundle:
#      a `swift run` binary never touches it and reads secrets from here.
#   3. this .env file
#   4. the built-in default
#
# The bundled .app launches with CWD=/, so for the .app put your real
# .env at:  ~/Library/Application Support/minnas/.env
# For `swift run` from the repo root, a ./.env here works too.
#
# OPENAI_API_KEY: only needed when transcribing with the cloud model (the
# local WhisperKit models need no key). Cloud models are offered only when
# cloud transcription is also switched on in Settings › Cloud.
OPENAI_API_KEY=sk-...

# TRANSCRIPTS_DIR: the folder finished transcripts are written to as
# Markdown. Normally chosen in first-run setup or Settings › General.
# TRANSCRIPTS_DIR=~/Documents/Minnas Transcripts

# STT_LANGUAGE: transcription language. Default "auto" — detects per
# recording among the STT_LANGUAGES candidates. Pin explicitly with a
# Whisper language code ("en", "sv", "de", …) to skip detection.
# STT_LANGUAGE=auto

# STT_LANGUAGES: candidate languages for "auto" detection, primary first
# (the languages you actually speak). Detection is constrained to these so
# it can never mis-fire to a third language. Default "en".
# STT_LANGUAGES=en,sv

# STT_LANGUAGE_MARGIN: the primary-language prior. A non-primary language
# (second+ entry of STT_LANGUAGES) must beat the primary by this much in the
# detection probe (summed language-token probabilities over the probe
# windows; 0.2 is a fifth of one confident window) to be chosen, so a
# near-tie goes to the primary. Dropped automatically when an attendee's
# e-mail ends in that language's country TLD (e.g. .se for Swedish).
# 0 disables.
# STT_LANGUAGE_MARGIN=0.2

# OWNER_EMAIL: your own email. Lets a 1:1 meeting name the other party (the
# "Them" speaker) from the calendar attendees instead of labeling it "Them".
# OWNER_EMAIL=you@example.com

# RECORDINGS_KEEP_DAYS: delete recorded audio older than this many days on
# launch (0 = keep forever). A transcript not yet written to the
# transcripts folder is never pruned. Default 30.
# RECORDINGS_KEEP_DAYS=30

# AUTO_STOP_SILENCE_MINUTES: stop a recording after this many minutes of
# silence on both streams (0 = never). Default 10.
# AUTO_STOP_SILENCE_MINUTES=10

# SYSTEM_AUDIO_ENGINE: how the other side of a call is captured. "taps"
# (default) is a Core Audio process tap and needs only the System Audio
# Recording permission; "sck" is ScreenCaptureKit and needs Screen
# Recording.
# SYSTEM_AUDIO_ENGINE=taps

# SYSTEM_AUDIO_EXCLUDE_BUNDLES: apps whose audio is kept OUT of the system
# ("Them") track. Needed for audio tools that monitor your own mic back out
# (a mic routed through filters into a virtual device for the call app) —
# otherwise your processed voice lands in "Them" and is transcribed twice.
# Comma-separated bundle IDs. Default: none.
# SYSTEM_AUDIO_EXCLUDE_BUNDLES=com.example.audio-tool

# STT_DEDUPE_STREAMS: when the mic and system streams are near-duplicates
# (recording on speakers), transcribe only the mic. Default OFF — it
# collapses a conversation to all "Me" and loses the clean "Them". Opt in
# only if you record on speakers and don't need Me/Them separation.
# STT_DEDUPE_STREAMS=true

# MIC_VOICE_PROCESSING: acoustic echo cancellation mode — auto (default) /
# on / off. "auto" enables it only on built-in-speaker output with a
# non-Bluetooth mic (where it cleans up room bleed and actually works);
# stays off for Bluetooth/headset (no bleed, and VPIO+BT = silent mic).
# "on" forces it (risky over Bluetooth); "off" always uses the raw mic.
# MIC_VOICE_PROCESSING=auto

# VOICE_MEMO_TRANSCRIPT: what an imported iPhone Voice Memo is transcribed
# with. "whisper" (default) runs the default model (Settings ›
# Transcription; Large v3 unless changed) on it like any recording; "apple" keeps the iPhone's on-device transcript when
# the memo carries one (instant, but loose with names).
# VOICE_MEMO_TRANSCRIPT=whisper

# DIARIZE: whether the local models split the "Them" stream (and imported
# single-stream files) into distinct speakers — "Them (A)", "Them (B)" —
# with FluidAudio's on-device pyannote pipeline (models ~50 MB, downloaded
# on first use into ~/Library/Application Support/FluidAudio/Models). "on"
# (default) or "off". Skipped automatically in a 1:1, where the stream is
# the other attendee by name. The cloud model diarizes on its own.
# DIARIZE=on
